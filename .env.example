# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM provider: stub (offline), openai (Chat Completions), deepseek (Responses API),
# or openrouter (Chat Completions). Switch providers by changing LLM_PROVIDER.
LLM_PROVIDER=stub
LLM_MODEL=stub-model
LLM_API_KEY=
# OpenRouter-only key and model. Preferred over LLM_API_KEY / LLM_MODEL when
# LLM_PROVIDER=openrouter, so the openai/deepseek settings can stay in place.
# Pin another free model here, e.g. google/gemma-3-27b-it:free
# Leave OPENROUTER_MODEL blank to reuse an explicit non-stub LLM_MODEL.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_API_KEY=
# Optional OpenRouter ranking headers. Leave blank to omit them.
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=
# Optional; defaults: openai -> https://api.openai.com/v1,
# deepseek -> https://api.deepseek.com, openrouter -> https://openrouter.ai/api/v1
# DeepSeek examples: deepseek-v4-pro, deepseek-v4-flash
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
# Optional separate verifier model; leave blank to reuse the active provider model
VERIFIER_LLM_MODEL=

# Agent loop limits
AGENT_MAX_ITERATIONS=3
AGENT_MAX_TOOL_CALLS=10
AGENT_MAX_RETRIEVAL_ROUNDS=3
AGENT_REQUEST_TIMEOUT_SECONDS=60

# LangGraph checkpointing (short-term thread memory)
AGENT_CHECKPOINTING_ENABLED=true
AGENT_CHECKPOINT_BACKEND=sqlite
AGENT_CHECKPOINT_SQLITE_PATH=data/checkpoints.sqlite

# Curriculum Structure API (read-only)
CURRICULUM_API_URL=http://127.0.0.1:8000
CURRICULUM_API_BASE_URL=http://127.0.0.1:8000
CURRICULUM_API_TIMEOUT=15

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM provider (Sprint 1 uses a stub when no key is set)
LLM_PROVIDER=stub
LLM_MODEL=stub-model
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# Agent loop limits (enforced in later sprints)
AGENT_MAX_ITERATIONS=3
AGENT_MAX_TOOL_CALLS=10
AGENT_REQUEST_TIMEOUT_SECONDS=60

# Future: Curriculum Structure API (read-only; unused in Sprint 1)
CURRICULUM_API_BASE_URL=http://127.0.0.1:8000

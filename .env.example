# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM provider: stub (offline), openai (Chat Completions), or deepseek (Responses API)
LLM_PROVIDER=stub
LLM_MODEL=stub-model
LLM_API_KEY=
# Optional; defaults: openai -> https://api.openai.com/v1, deepseek -> https://api.deepseek.com
# DeepSeek examples: deepseek-v4-pro, deepseek-v4-flash
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
# Optional separate verifier model; leave blank to reuse LLM_MODEL with a distinct prompt
VERIFIER_LLM_MODEL=

# Agent loop limits
AGENT_MAX_ITERATIONS=3
AGENT_MAX_TOOL_CALLS=10
AGENT_MAX_RETRIEVAL_ROUNDS=3
AGENT_REQUEST_TIMEOUT_SECONDS=60

# LangGraph checkpointing (short-term thread memory)
AGENT_CHECKPOINTING_ENABLED=true
AGENT_CHECKPOINT_BACKEND=sqlite
AGENT_CHECKPOINT_SQLITE_PATH=data/checkpoints.sqlite

# Curriculum Structure API (read-only)
CURRICULUM_API_URL=http://127.0.0.1:8000
CURRICULUM_API_BASE_URL=http://127.0.0.1:8000
CURRICULUM_API_TIMEOUT=15

# V2.13D production shadow (observational only; does not change user-facing answers)
# Code defaults remain disabled (false / 0). Phase 1 observation uses 1% sampling.
V213D_SHADOW_ENABLED=false
V213D_SHADOW_SAMPLE_RATE=0
V213D_SHADOW_DOCUMENT_RETRIEVAL=true
V213D_SHADOW_RETRIEVAL_VARIANT=context_hybrid
V213D_SHADOW_TIMEOUT_SECONDS=30

# V2.13F document evidence arbitration (shadow/replay harness only; never on by default)
V213F_DOCUMENT_ARBITRATION_EXPERIMENT=false
V213F_ARBITRATION_POLICY=C_ARBITRATED

# V2.13G live dual-arm arbitration shadow (observational only; default off)
# When true with V2.13D sampling: retrieve once, run baseline + arbitrated arms.
# Never changes user-facing answers. Keep V213F_DOCUMENT_ARBITRATION_EXPERIMENT=false.
V213G_LIVE_ARBITRATION_SHADOW=false
# V2.13G.1 shadow-only PROVENANCE_ONLY semantics (does not affect production answers):
# structured_only_regeneration (default) | preserve_control_answer
V213G_PROVENANCE_ONLY_SEMANTICS=structured_only_regeneration

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM provider: stub (offline) or openai
LLM_PROVIDER=stub
LLM_MODEL=stub-model
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30

# Agent loop limits
AGENT_MAX_ITERATIONS=3
AGENT_MAX_TOOL_CALLS=10
AGENT_REQUEST_TIMEOUT_SECONDS=60

# Curriculum Structure API (read-only)
CURRICULUM_API_URL=http://127.0.0.1:8000
CURRICULUM_API_BASE_URL=http://127.0.0.1:8000
CURRICULUM_API_TIMEOUT=15

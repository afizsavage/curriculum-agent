# Runtime. development and test may call legacy POST /api/v1/agent/ask without
# a session only while ASSISTANT_AUTH_ENABLED=false. production, staging, and
# any other name require the identity gate and the ownership ledger regardless
# of that flag.
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM provider: stub (offline), openai (Chat Completions), deepseek (Responses API),
# or openrouter (Chat Completions). Switch providers by changing LLM_PROVIDER.
LLM_PROVIDER=stub
LLM_MODEL=stub-model
LLM_API_KEY=
# OpenRouter-only key and model. Preferred over LLM_API_KEY / LLM_MODEL when
# LLM_PROVIDER=openrouter, so the openai/deepseek settings can stay in place.
# Pin another free model here, e.g. google/gemma-3-27b-it:free
# Leave OPENROUTER_MODEL blank to reuse an explicit non-stub LLM_MODEL.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_API_KEY=
# Optional OpenRouter ranking headers. Leave blank to omit them.
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=
# Optional; defaults: openai -> https://api.openai.com/v1,
# deepseek -> https://api.deepseek.com, openrouter -> https://openrouter.ai/api/v1
# DeepSeek examples: deepseek-v4-pro, deepseek-v4-flash
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
# Optional separate verifier model; leave blank to reuse the active provider model
VERIFIER_LLM_MODEL=

# Agent loop limits
AGENT_MAX_ITERATIONS=3
AGENT_MAX_TOOL_CALLS=10
AGENT_MAX_RETRIEVAL_ROUNDS=3
AGENT_REQUEST_TIMEOUT_SECONDS=60

# LangGraph checkpointing (short-term thread memory)
AGENT_CHECKPOINTING_ENABLED=true
AGENT_CHECKPOINT_BACKEND=sqlite
AGENT_CHECKPOINT_SQLITE_PATH=data/checkpoints.sqlite
# Legacy QA conversation ownership. Separate from checkpoints, assistant
# threads, and teacher accounts. Required for ask outside development and test.
QA_CONVERSATION_OWNER_SQLITE_PATH=data/qa_conversation_owners.sqlite

# Teacher assistant HTTP. Off by default. Enabling it does not authenticate
# teachers. A registered identity gate is required, except for explicit local
# stub identity outside production. Do not send a teacher id in the request.
ASSISTANT_ENABLED=false
ASSISTANT_LOCAL_STUB_IDENTITY=false
ASSISTANT_LOCAL_STUB_TEACHER_ID=local-stub-teacher
ASSISTANT_THREAD_SQLITE_PATH=data/assistant_threads.sqlite

# Teacher session authentication. Off by default. It does not enable
# ASSISTANT_ENABLED and it does not trust a teacher id from the request.
# There is no default password and no public registration endpoint.
# An operator creates the first account with:
#   python -m app.assistant.provision --username teacher.one
# The command prompts for a password. For a non-interactive shell, set
# ASSISTANT_ACCOUNT_PASSWORD in that command's environment only.
# Do not commit that password. The command does not print the hash or a session token.
# Turn sessions on with ASSISTANT_AUTH_ENABLED=true after the account exists.
# Do not set ASSISTANT_LOCAL_STUB_IDENTITY at the same time; startup will refuse.
ASSISTANT_AUTH_ENABLED=false
ASSISTANT_AUTH_SQLITE_PATH=data/assistant_auth.sqlite
ASSISTANT_SESSION_COOKIE_NAME=marcus_session
ASSISTANT_AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Opt-in live behaviour evaluation. Leave unset for tests and deployments.
# Run only as: ASSISTANT_EVAL_LIVE=1 python scripts/eval_assistant_behaviour.py --live
# That command does not turn on the assistant HTTP route.

# Curriculum Structure API (read-only)
CURRICULUM_API_URL=http://127.0.0.1:8000
CURRICULUM_API_BASE_URL=http://127.0.0.1:8000
CURRICULUM_API_TIMEOUT=15
